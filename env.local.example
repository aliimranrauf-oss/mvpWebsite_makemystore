# Copy this file to .env.local for local development and add the same
# values to Vercel project settings for production/preview.

# Supabase project settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only needed if wiring up email notifications on the contact form
RESEND_API_KEY=

# Chat widget: "faq" (default, free, no key needed), "ai", or "off"
NEXT_PUBLIC_CHATBOT_MODE=faq

# Only needed when NEXT_PUBLIC_CHATBOT_MODE=ai
# Get a free key at https://aistudio.google.com/apikey (Gemini free tier)
GEMINI_API_KEY=
